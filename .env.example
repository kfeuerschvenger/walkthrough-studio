# Copy to .env.local and adjust. Every variable is optional.

# API server bind address and port
HOST=127.0.0.1
PORT=3001

# Extra hostnames allowed to reach the API, comma separated (needed with HOST=0.0.0.0 on a LAN)
# ALLOWED_HOSTS=192.168.1.10

# Folder where the API stores the scene and uploaded textures (default: server/data)
# DATA_DIR=server/data

# Folder served read-only at /models, for a private model kept outside the repository
# MODELS_DIR=./models

# Model to load. Supports .fbx, .glb and .gltf (default: the bundled demo house)
VITE_HOUSE_URL=/demo/house.glb

# Walkthrough spawn point as "x,z" in metres (default: -2,0)
# VITE_HOUSE_SPAWN=-2,0

# Comma-separated mesh names used to anchor the ground level (default: lowest point of the model)
# VITE_HOUSE_GROUND_HINTS=

# Rotation of the sun path around the vertical axis, in degrees (default: 0)
# VITE_SUN_PATH_ROTATION_DEG=0