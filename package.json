{
  "name": "walkthrough",
  "description": "A 3D house walkthrough with a texture and lighting editor: paint the walls before you buy the paint.",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "author": "Kevin Feuerschvenger (https://feuerschvenger.com/)",
  "homepage": "https://github.com/kfeuerschvenger/walkthrough-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kfeuerschvenger/walkthrough-studio.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,api -c blue,green \"npm:dev:vite\" \"npm:dev:api\"",
    "dev:vite": "vite",
    "dev:api": "tsx watch server/server.ts",
    "typecheck": "tsc -b",
    "build": "npm run typecheck && vite build",
    "build:demo-house": "node scripts/build-demo-house.mjs",
    "build:server": "tsc -p server/tsconfig.build.json",
    "start": "tsx server/server.ts",
    "start:prod": "node dist-server/server/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "preview": "vite preview",
    "showcase:install": "npm --prefix e2e ci && npm --prefix e2e run install:browsers",
    "showcase:seed": "node e2e/showcase/seed.mjs",
    "showcase:capture": "npm --prefix e2e run showcase",
    "showcase:gif": "npm --prefix e2e run showcase:gif"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/express": "^5.0.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^9.2.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "supertest": "^7.3.1",
    "three": "^0.184.0",
    "three-stdlib": "^2.36.1",
    "tsx": "^4.20.6",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.5"
  }
}
