# Walkthrough Studio architecture, dark variant: the light diagram with dark tones of the same six hues.
...@architecture

style.fill: "#0d1220"

classes.paint.style: {fill: "#4a2e08"; stroke: "#f99a1c"; font-color: "#ffe2b8"}
classes.light.style: {fill: "#3b2a10"; stroke: "#ffb347"; font-color: "#ffe9cc"}
classes.sky.style: {fill: "#17324f"; stroke: "#bde0ff"; font-color: "#dbeeff"}
classes.steel.style: {fill: "#2a2c33"; stroke: "#9a9a96"; font-color: "#e6e6e2"}
classes.night.style: {fill: "#1a2540"; stroke: "#bde0ff"; font-color: "#ffffff"}
classes.group-paint.style: {fill: "#1d1710"; stroke: "#f99a1c"; font-color: "#ffd59a"}
classes.group-sky.style: {fill: "#0f1b2d"; stroke: "#bde0ff"; font-color: "#bde0ff"}
classes.group-steel.style: {fill: "#16171c"; stroke: "#9a9a96"; font-color: "#d0d0cc"}
classes.flow.style: {stroke: "#ffb347"; font-color: "#ffd59a"}
