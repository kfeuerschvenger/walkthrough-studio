# Dependencies and build output are rebuilt inside the image
node_modules
dist
dist-server
dist-ssr
coverage

# Runtime data is a volume, never part of the image
server/data

# Private models and secrets stay out of the build context. Models are
# mounted at run time; Vite settings come in as build arguments.
*.fbx
.env
.env.*
*.local
.no-telemetry

# Source material for the demo model, not needed to build the app
assets-src

# Version control, editor, and OS files
.git
.gitignore
.vscode
.idea
.DS_Store
Thumbs.db
*.log

# Docker files do not need to be inside the image
Dockerfile
docker-compose.yml
.dockerignore
